#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 900

&mmv {
    time-to-max-speed-ms = <450>;
    acceleration-exponent = <1>;
};


/ {

        macros {
        mouse_left: mouse_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Mouse Left";
            wait-ms = <0>;
            tap-ms = <0>;

            bindings =
                <&macro_press &mmv MOVE_LEFT>,
                <&macro_pause_for_release>,
                <&macro_release &mmv MOVE_LEFT>;
        };

        mouse_right: mouse_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Mouse Right";
            wait-ms = <0>;
            tap-ms = <0>;

            bindings =
                <&macro_press &mmv MOVE_RIGHT>,
                <&macro_pause_for_release>,
                <&macro_release &mmv MOVE_RIGHT>;
        };

        mouse_up: mouse_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Mouse Up";
            wait-ms = <0>;
            tap-ms = <0>;

            bindings =
                <&macro_press &mmv MOVE_UP>,
                <&macro_pause_for_release>,
                <&macro_release &mmv MOVE_UP>;
        };

        mouse_down: mouse_down {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Mouse Down";
            wait-ms = <0>;
            tap-ms = <0>;

            bindings =
                <&macro_press &mmv MOVE_DOWN>,
                <&macro_pause_for_release>,
                <&macro_release &mmv MOVE_DOWN>;
        };


        scroll_left: scroll_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Scroll Left";
            wait-ms = <0>;
            tap-ms = <0>;

            bindings =
                <&macro_press &msc SCRL_LEFT>,
                <&macro_pause_for_release>,
                <&macro_release &msc SCRL_LEFT>;
        };

        scroll_right: scroll_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Scroll Right";
            wait-ms = <0>;
            tap-ms = <0>;

            bindings =
                <&macro_press &msc SCRL_RIGHT>,
                <&macro_pause_for_release>,
                <&macro_release &msc SCRL_RIGHT>;
        };

        scroll_up: scroll_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Scroll Up";
            wait-ms = <0>;
            tap-ms = <0>;

            bindings =
                <&macro_press &msc SCRL_UP>,
                <&macro_pause_for_release>,
                <&macro_release &msc SCRL_UP>;
        };

        scroll_down: scroll_down {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Scroll Down";
            wait-ms = <0>;
            tap-ms = <0>;

            bindings =
                <&macro_press &msc SCRL_DOWN>,
                <&macro_pause_for_release>,
                <&macro_release &msc SCRL_DOWN>;
        };


        mouse_lclick: mouse_lclick {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Left Click";
            wait-ms = <0>;
            tap-ms = <0>;

            bindings =
                <&macro_press &mkp LCLK>,
                <&macro_pause_for_release>,
                <&macro_release &mkp LCLK>;
        };

        mouse_rclick: mouse_rclick {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Right Click";
            wait-ms = <0>;
            tap-ms = <0>;

            bindings =
                <&macro_press &mkp RCLK>,
                <&macro_pause_for_release>,
                <&macro_release &mkp RCLK>;
        };

        mouse_mclick: mouse_mclick {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Middle Click";
            wait-ms = <0>;
            tap-ms = <0>;

            bindings =
                <&macro_press &mkp MCLK>,
                <&macro_pause_for_release>,
                <&macro_release &mkp MCLK>;
        };


        mouse_back: mouse_back {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Mouse Back";
            wait-ms = <0>;
            tap-ms = <0>;

            bindings =
                <&macro_press &mkp MB4>,
                <&macro_pause_for_release>,
                <&macro_release &mkp MB4>;
        };

        mouse_forward: mouse_forward {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Mouse Forward";
            wait-ms = <0>;
            tap-ms = <0>;

            bindings =
                <&macro_press &mkp MB5>,
                <&macro_pause_for_release>,
                <&macro_release &mkp MB5>;
        };
    };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
// | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
//                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |
                        bindings = <
   &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
   &kp LCTRL &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
   &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp ESC
                  &kp LGUI &mo 1 &kp SPACE   &kp RET &mo 2 &kp RALT
                        >;
                display-name = "LAYER 0";
                };
                lower_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
// | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
// | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <
   &kp TAB    &kp N1       &kp N2       &kp N3       &kp N4       &kp N5         &kp N6   &kp N7   &kp N8 &kp N9    &kp N0 &kp BSPC
   &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &trans
   &kp LSHFT  &trans       &trans       &trans       &trans       &trans         &trans   &trans   &trans &trans    &trans &trans
                                    &kp LGUI     &trans       &kp SPACE      &kp RET  &trans   &kp RALT
                        >;
                display-name = "LAYER 1";
                };

                raise_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
// | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
// | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <
   &kp  TAB  &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp KP_MULTIPLY &kp LPAR &kp RPAR &kp BSPC
   &kp LCTRL &trans   &trans &trans   &trans   &trans      &kp MINUS &kp EQUAL &kp LBKT        &kp RBKT &kp BSLH &kp GRAVE
   &kp LSHFT &trans   &trans &trans   &trans   &trans      &kp UNDER &kp PLUS  &kp LBRC        &kp RBRC &kp PIPE &kp TILDE
                             &kp LGUI &trans   &kp SPACE   &kp RET   &trans    &kp RALT
                        >;
                display-name = "LAYER 2";
                };
        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };

        extra3 { status = "reserved"; };

        extra4 { status = "reserved"; };

        extra5 { status = "reserved"; };
        };
};
